{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "server.main:app"
    },
    "embed": {
      "root": "embed",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/coltek-chat.js",
      "destination": { "service": "embed" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/admin(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/health",
      "destination": { "service": "app" }
    }
  ]
}
