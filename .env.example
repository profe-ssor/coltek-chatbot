# OpenAI
OPENAI_API_KEY=sk-proj-your-real-key-here
OPENAI_MODEL=gpt-4.1-mini

# Knowledge (filled in after Part 3b upload script runs)
VECTOR_STORE_ID=

# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# CORS – your website domains, comma-separated
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Database (Part 6a – leave as SQLite for now)
DATABASE_URL=sqlite:///./chatbot.sqlite3

# Only trust X-Forwarded-For from our own proxy (Nginx on the same host)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Agent memory: how many session items the model sees per turn
SESSION_HISTORY_LIMIT=40

# OpenAI traces: keep false in production (no visitor messages, names or phone numbers in traces).
# Set true only locally while debugging.
TRACE_INCLUDE_SENSITIVE_DATA=false

# Rate limiting (Part 8)
RATE_LIMIT_PER_HOUR=20

# Team email after every new lead or demo request (chatbot/notify.py)
# Leave SMTP_HOST empty to switch email off (a warning is logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
NOTIFY_EMAIL_TO=team@example.com